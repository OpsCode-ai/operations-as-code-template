  "statusLine": {
    "type": "command",
    "command": "[ -n \"$AIDLC\" ] && exec bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/aidlc-statusline.ts\"; for s in \"$CLAUDE_PROJECT_DIR/scripts/oac-statusline.sh\" \"$CLAUDE_PROJECT_DIR/code/scripts/oac-statusline.sh\" \"$HOME/.claude/statusline-command.sh\"; do [ -f \"$s\" ] && exec bash \"$s\"; done; exit 0"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/oac-session-brief.py\" ] && exit 0; b=\"$CLAUDE_PROJECT_DIR/scripts/oac-session-brief.py\"; [ -f \"$b\" ] || exit 0; python3 \"$b\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "b=\"$CLAUDE_PROJECT_DIR/scripts/oac-session-brief.py\"; [ -f \"$b\" ] || b=\"$CLAUDE_PROJECT_DIR/code/scripts/oac-session-brief.py\"; [ -f \"$b\" ] && python3 \"$b\" --announce --write >/dev/null 2>&1; exit 0"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "b=\"$CLAUDE_PROJECT_DIR/scripts/oac-session-brief.py\"; [ -f \"$b\" ] || b=\"$CLAUDE_PROJECT_DIR/code/scripts/oac-session-brief.py\"; [ -f \"$b\" ] && python3 \"$b\" --announce --write >/dev/null 2>&1; exit 0"
          }
        ]
      }
    ]
  }
